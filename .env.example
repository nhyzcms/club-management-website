# 运行期配置模板 —— 复制为 .env（.gitignore 已忽略 .env）后按需填写。
# 本文件入库，只放占位与说明，绝不放真实凭据。
#
# 后端启动（start.sh / manage.py）在缺失 .env 时会从本模板复制一份。

# ---- Django 核心 ----
# 必改：生产用 `python -c "import secrets;print(secrets.token_urlsafe())"` 生成强随机值。
# 留空：DEBUG 开启时回退 settings.py 公开占位；DJANGO_DEBUG=0 时必须填写，否则拒绝启动。
SECRET_KEY=
# 调试模式：生产务必设 0 / false。本地默认开。
DJANGO_DEBUG=1
# 允许的主机，逗号分隔，如 media-club.example.com,api.example.com
ALLOWED_HOSTS=
# 前端来源（拼邮件链接用，如 https://media-club.example.com）
FRONTEND_URL=http://localhost:3000

# ---- 163 邮箱 SMTP（自助注册验证邮件 / 密码重置邮件）----
# 配了 EMAIL_HOST_USER 即切到 SMTP（smtp.163.com:465 SSL）；留空则 dev 用 console（邮件打终端）。
# EMAIL_HOST_PASSWORD 填 163 邮箱的「SMTP 授权码」，不是登录密码。
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- 通知外发投递（可选）----
# 默认异步：通知外发走进程内投递队列（不阻塞请求、失败按退避自动重试）。
# 设 0 回退旧的同步投递（请求内发送、失败仅留痕）。详见 docs/adr/0024。
# NOTIFICATIONS_DELIVERY_ASYNC=0

# ---- Cloudflare Turnstile（自助注册人机校验）----
# 两项都留空 = 关闭。都填了才启用：sitekey 经 GET /site-policy/ 下发给前端，secret 保密。
# 申请：https://dash.cloudflare.com → Turnstile，模式选 Managed。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- 自动更新（GitHub Release；start.sh 与 Gunicorn 一同拉起）----
# PAT，需能读该仓库的 Releases。生产必填；窗口/轮询等旋钮在 Django admin「站点策略」。
UPDATE_GITHUB_TOKEN=
# owner/repo；缺省 nhyzcms/club-management-website
UPDATE_GITHUB_REPO=nhyzcms/club-management-website

# ---- 更新器出站代理（可选，仅作用于更新器进程）----
# 无直连 GitHub 通道、Release 下载慢时配置（如 http://127.0.0.1:7891）。
# 只给守护进程注入 HTTPS_PROXY/HTTP_PROXY；gunicorn/Django 与业务出站（SMTP 等）不受影响。
# CLUB_UPDATER_PROXY=
# 代理例外名单，缺省 127.0.0.1,localhost。
# CLUB_UPDATER_NO_PROXY=

# ---- 数据库（可选：PostgreSQL；缺省 SQLite）----
# 设 DB_ENGINE=postgresql 即切换（读取下方连接项）；缺省/留空 = 维持 SQLite 不变。
# PG 与站点同机部署时应只监听 127.0.0.1；切换前先迁移数据（dump/load），回滚 = 改回此键。
# DB_ENGINE=postgresql
# DB_NAME=club
# DB_USER=club
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ---- Redis（可选：缓存 + Channels 频道层）----
# 配置后：Django 缓存与 WebSocket 频道层都走 Redis；且允许 GUNICORN_WORKERS > 1。
# REDIS_URL=redis://127.0.0.1:6379/0

# ---- ASGI worker 进程数（默认 1；须先配 REDIS_URL 再加，见 docs/adr）----
# GUNICORN_WORKERS=1
