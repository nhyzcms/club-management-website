# test 环境配置模板。
#
# 服务器上：install 到 /opt/club-test/.env（600，属主 clubdeploy），改掉三处 change-me。
# 本机调试：cp deploy/test/.env.example .env，同样改三处，然后按 README 起栈。
#
# 注意：这个环境是 DEBUG=1，错误页会带 traceback 与 settings 片段；
# HTTP Basic 只挡人，不加密（明文 HTTP）。只给内部测试用。

# ---- Django 核心 ----
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=1
# 服务器上要加公网 IP；本机调试保留 localhost,127.0.0.1 即可。
ALLOWED_HOSTS=localhost,127.0.0.1
# 邮件里的链接前缀；服务器上改成 http://8.153.145.175:52603
FRONTEND_URL=http://127.0.0.1:52603

# ---- 数据根 ----
# 容器内路径；compose 把宿主机目录挂到这里（/opt/club-test/data 或 ../../data）。
CLUB_DATA_DIR=/app/data

# ---- 数据库（同一 compose 里的 db 服务）----
DB_ENGINE=postgresql
DB_NAME=club_test
DB_USER=club
DB_PASSWORD=change-me-to-a-random-value
DB_HOST=db
DB_PORT=5432

# ---- Redis（同一 compose 里的 redis 服务）----
REDIS_URL=redis://redis:6379/0

# 测试站人不多，2 个 worker 足够；频道层走 Redis，可以 >1。
GUNICORN_WORKERS=2

# ---- HTTP Basic 闸门 ----
# 两个都填才启用；生产环境不填 = 中间件 no-op。
TEST_BASIC_AUTH_USER=club
TEST_BASIC_AUTH_PASSWORD=change-me-to-a-random-value
